# tallee Match-Sharing relay configuration. Copy to ".env" and adjust.

# How long a shared match stays retrievable, in seconds.
TTL_SECONDS=600

# Reject uploads larger than this many bytes.
MAX_PAYLOAD_BYTES=262144

# Comma-separated allowed CORS origins, or "*" for any.
CORS_ORIGINS=*

# Per-IP rate limits
RATE_LIMIT_CREATE=30/minute
RATE_LIMIT_READ=120/minute
